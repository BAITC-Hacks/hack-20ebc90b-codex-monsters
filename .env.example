EKT_DATA_DIR=./var
EKT_HOST=127.0.0.1
EKT_PORT=8000
EKT_API_URL=http://127.0.0.1:8000
EKT_DEMO_ACTOR=demo-buyer
EKT_DEMO_ROLE=approver
# scripts/run_app.py starts both services in HTTP mode. Export these variables
# in your shell; the Python launcher does not implicitly read .env files.
API_PORT=8000
UI_PORT=8501
# PORT is the hosting platform fallback when UI_PORT is not set.
# PORT=8501
# Lock server-side API destination before exposing a public demo.
BUYER_LOCK_CONNECTION=true
# Docker Compose reads .env only for substitution of its published UI port.
EKT_BIND_ADDRESS=127.0.0.1
EKT_UI_PORT=8501
# Optional local-only registered source manifest. Never commit corporate raw data.
# EKT_SOURCE_CONFIG=./config/local-sources.json
